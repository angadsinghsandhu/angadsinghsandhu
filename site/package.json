{
  "name": "angad-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format:check": "prettier --ignore-path ../.gitignore --check . ../.github/workflows/portfolio.yml",
    "check:lines": "node scripts/check-lines.mjs",
    "check:types": "astro check",
    "test:unit": "node --test 'tests/**/*.test.mjs' && vitest run",
    "test:browser": "playwright test",
    "verify": "npm run format:check && npm run check:lines && npm run check:types && npm run test:unit && npm run build && npm run test:browser",
    "verify:output": "node scripts/verify-output.ts",
    "build:release": "node scripts/import-notes-release.ts",
    "import:notes": "node scripts/import-notes.ts",
    "build:notes-preview": "node scripts/import-notes-release.ts --preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.4.13",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-html": "9.0.5",
    "katex": "0.19.0",
    "pdfjs-dist": "6.4.299",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "pagefind": "1.5.2",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
