---
import wave from "../assets/signal-wave.svg?raw";
---

<div class="art" set:html={wave} />
<button type="button" class="replay" data-replay hidden>
  Replay motion
</button>

<script>
  const replay = document.querySelector<HTMLButtonElement>("[data-replay]");
  const pulse = document.querySelector(".signal-pulse");

  if (replay && pulse) {
    replay.hidden = false;
    replay.addEventListener("click", () => {
      pulse.classList.remove("signal-pulse");
      pulse.getBoundingClientRect();
      pulse.classList.add("signal-pulse");
    });
  }
</script>

<style>
  .art {
    position: absolute;
    z-index: -1;
    inset: 0 calc(-1 * var(--page-inset)) 0 25%;
    overflow: hidden;
    background: radial-gradient(
      ellipse at 70% 58%,
      color-mix(in oklab, var(--brand) 24%, transparent),
      transparent 63%
    );
    mask-image: linear-gradient(90deg, transparent, black 31%);
    pointer-events: none;
  }

  .art :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .art :global(.signal-mesh) {
    color: var(--accent);
    opacity: 0.59;
  }

  .art :global(.signal-pulse) {
    opacity: 0;
    animation: signal-sweep 1550ms cubic-bezier(0.2, 0.6, 0.35, 1) both;
  }

  @keyframes signal-sweep {
    0% {
      opacity: 0;
      transform: translateX(-71%);
    }

    24% {
      opacity: 0.9;
    }

    72% {
      opacity: 0.75;
    }

    100% {
      opacity: 0;
      transform: translateX(70%);
    }
  }

  .replay {
    position: absolute;
    right: 0;
    bottom: 0;
    min-height: var(--target);
    padding: 8px 10px;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: 400 0.75rem/1.5 var(--mono);
  }

  @media (hover: hover) {
    .replay:hover {
      background: var(--graphite);
      color: var(--accent);
    }
  }

  @media (max-width: 620px) {
    .art {
      position: relative;
      inset: auto;
      aspect-ratio: 1.85;
      margin: 10px calc(-1 * var(--page-inset)) 30px;
      mask-image: linear-gradient(
        0deg,
        transparent,
        black 20%,
        black 87%,
        transparent
      );
    }

    .replay {
      bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .art :global(.signal-pulse) {
      animation: none;
    }

    .replay {
      display: none;
    }
  }
</style>
