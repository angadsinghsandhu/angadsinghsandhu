---
import "katex/dist/katex.min.css";
import "../../styles/reader.css";
import TableOfContents from "../notes/TableOfContents.astro";
import OwnerProgress from "./OwnerProgress.astro";
import TracePlayer from "./TracePlayer.astro";
import {
  numberPracticeCodeLines,
  practiceLessonRevision,
  preparePracticeProse,
  type PracticeLessonProps,
} from "../../lib/practice-lessons";

type Props = PracticeLessonProps;
const { lesson, problem, sources } = Astro.props;
const prose = preparePracticeProse(
  lesson.bodyHtml,
  lesson.headings,
  problem.title,
);
const headings = [
  ...prose.headings,
  ...lesson.approaches.map(({ id, title }) => ({
    id: `approach-${id}`,
    text: title,
    depth: 2,
  })),
];
---

<article class="lesson reader-column" data-pagefind-body>
  <header class="reader-header">
    <p class="label">LeetCode · {problem.difficulty}</p>
    <h1 id={prose.titleId} data-pagefind-meta="title">
      {problem.number}. {problem.title}
    </h1>
    <div class="actions" data-pagefind-ignore>
      <a class="action" href={problem.officialUrl}>
        Open on LeetCode
      </a>
      {sources.map(({ title, route }) => (
        <a class="action" href={route}>
          Original source · {title}
        </a>
      ))}
      <OwnerProgress />
      <OwnerProgress
        problemId={problem.id}
        lessonRevision={practiceLessonRevision(lesson)}
      />
    </div>
  </header>
  <TableOfContents {headings} variant="disclosure" />

  {/* Author prose and highlighted code were sanitized or generated by the pinned Notes exporter. */}
  <div class="reader-body" set:html={prose.html} />

  {lesson.approaches.map((approach) => {
    const { id, title, language, codeHtml, transcripts } = approach;
    const sectionId = `approach-${id}`;
    return (
      <section
        class="approach"
        data-pagefind-ignore
        data-practice-approach={id}
      >
        <h2 id={sectionId}>{title}</h2>
        <div
          class="scroll-region"
          data-practice-code
          role="region"
          aria-label={`${title} · ${language} source code`}
          tabindex="0"
          set:html={numberPracticeCodeLines(codeHtml, sectionId)}
        />
        <TracePlayer problemId={problem.id} {approach} />
        {transcripts.length > 0 && (
          <section
            class="transcripts"
            aria-labelledby={`${sectionId}-transcripts`}
          >
            <h3 id={`${sectionId}-transcripts`}>Execution transcripts</h3>
            {transcripts.map(({ exampleId, steps }, index) => (
              <div>
                <h4 id={`${sectionId}-${exampleId}`}>
                  Example {index + 1} · {exampleId.replaceAll("-", " ")}
                </h4>
                <ol
                  data-practice-example={exampleId}
                  aria-labelledby={`${sectionId}-${exampleId}`}
                >
                  {steps.map(({ stepId, explanation, codeLines }) => (
                    <li data-practice-step={stepId}>
                      <p data-practice-explanation>{explanation}</p>
                      {codeLines.length > 0 && (
                        <span class="step-lines">
                          Code {codeLines.length === 1 ? "line" : "lines"}
                          {codeLines.map((line) => (
                            <a
                              data-practice-step-line={line}
                              href={`#${sectionId}-line-${line}`}
                              aria-label={`Code line ${line}`}
                            >
                              {line}
                            </a>
                          ))}
                        </span>
                      )}
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </section>
        )}
      </section>
    );
  })}

  <section
    class="evidence"
    data-pagefind-ignore
    aria-labelledby="company-evidence"
  >
    <h2 id="company-evidence">Company evidence</h2>
    {problem.companies.length > 0 ? (
      <ul>
        {problem.companies.map(
          ({ companyName, observedOn, reportingPeriod, sourceUrl }) => (
            <li>
              {sourceUrl ? <a href={sourceUrl}>{companyName}</a> : companyName}
              {" · "}
              <time datetime={observedOn}>{observedOn}</time>
              {reportingPeriod && ` · ${reportingPeriod}`}
            </li>
          ),
        )}
      </ul>
    ) : (
      <p>Unknown</p>
    )}
  </section>
</article>

<style>
  .lesson {
    --color-border: var(--rule);
    --color-link: var(--accent);
    --color-muted: var(--muted);
    --color-surface: var(--graphite);
    --font-code: var(--mono);
    overflow-wrap: anywhere;
  }

  .reader-header h1 {
    padding-block: 0.75rem 0.5rem;
    text-wrap: balance;
  }

  .lesson :global(.contents-disclosure) {
    display: block;
  }

  .lesson :global(.contents-disclosure summary) {
    display: list-item;
    padding: 0.5rem;
  }

  .approach,
  .evidence {
    margin-block-start: 2.5rem;
  }

  .approach h2,
  .transcripts h3,
  .evidence h2 {
    scroll-margin-block-start: 1.5rem;
  }

  .transcripts {
    margin-block-start: 1.5rem;
  }

  .transcripts h4 {
    margin-block: 1.25rem 0.5rem;
  }

  .transcripts ol {
    padding-inline-start: 1.625rem;
  }

  .transcripts li {
    margin-block: 0.25rem 0.75rem;
  }

  .transcripts p {
    white-space: pre-wrap;
  }

  .step-lines {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 0.25rem;
    color: var(--muted);
    font: 400 0.875rem/1.5 var(--mono);
  }

  .step-lines a {
    display: inline-grid;
    min-block-size: var(--target);
    min-inline-size: var(--target);
    place-items: center;
    border-radius: var(--radius);
  }

  [data-practice-code] :global([data-practice-line]:target) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
