---
import { useFixtures } from "../../content/catalog";

export function getStaticPaths() {
  return useFixtures ? [{ params: { fixture: "audio" } }] : [];
}

const { testTone } = await import("../../../tests/fixtures/editorial");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Playback fixture</title>
  </head>
  <body>
    <button type="button">Play fixture track</button>
    <audio controls aria-label="Fixture track" src={testTone()}></audio>
  </body>
</html>

<script>
  const audio = document.querySelector("audio");
  const button = document.querySelector("button");
  button?.addEventListener("click", () => void audio?.play());
</script>
