---
import LibraryLayout from "../../layouts/LibraryLayout.astro";
import Breadcrumbs from "../../components/notes/Breadcrumbs.astro";
import FolderTree from "../../components/notes/FolderTree.astro";
import { readPreparedCatalog } from "../../lib/notes-catalog";
const folders = (await readPreparedCatalog()).folders;
---

<LibraryLayout
  title="Folder tree"
  description="Explore the entire published folder hierarchy."
>
  <Breadcrumbs title="Folder tree" />
  <h1>Folder tree</h1>
  <p>Expand a branch with its arrow. Open any folder by its name.</p>
  <nav aria-label="All published folders">
    <FolderTree folders={folders} />
  </nav>
</LibraryLayout>
