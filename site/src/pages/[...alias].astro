---
import "../styles/tokens.css";
import { readPreparedCatalog } from "../lib/notes-catalog";

export async function getStaticPaths() {
  return (await readPreparedCatalog())
    .listEntries()
    .flatMap(({ aliases, route, title }) =>
      aliases.map((alias) => ({
        params: { alias: decodeURIComponent(alias).replace(/^\/|\/$/gu, "") },
        props: { target: route, title },
      })),
    );
}
interface Props {
  target: string;
  title: string;
}
const { target, title } = Astro.props;
const canonical = Astro.site ? new URL(target, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title} has moved · Angad Sandhu</title>
    <script define:vars={{ target }}>
      window.location.replace(target + window.location.hash);
    </script>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
  </head>
  <body data-pagefind-ignore>
    <main class="page-width">
      <h1>This note has moved</h1>
      <a class="action action--secondary" href={target}>
        Continue to {title}
      </a>
    </main>
  </body>
</html>
